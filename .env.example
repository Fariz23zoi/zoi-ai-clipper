# API mode (default)
MUAPI_API_KEY=your_muapi_key_here

# Local mode (--mode local)
LLM_PROVIDER=openai           # openai or gemini
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
LOCAL_WHISPER_MODEL=base
LOCAL_WHISPER_DEVICE=auto
LOCAL_OUTPUT_DIR=output

# ---- ZOI AI CLIPPER dashboard (app.py) ----
# Semua baris di bawah opsional. Dashboard berjalan tanpa API key.
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-5
# Alamat dashboard. 127.0.0.1 = hanya dari HP ini. 0.0.0.0 = seluruh Wi-Fi.
# ZOI_HOST=127.0.0.1
# ZOI_PORT=5000
# Kecepatan/kualitas render: ultrafast, veryfast (bawaan), fast
# ZOI_RENDER_PRESET=veryfast
# ZOI_RENDER_CRF=23
# Batas fps hasil render (0 = ikut sumber) dan prioritas FFmpeg (0 = normal)
# ZOI_RENDER_MAX_FPS=30
# ZOI_RENDER_NICE=10
# Kualitas render bawaan di dashboard: 240, 360, 480, 720, atau 1080
# ZOI_RENDER_QUALITY=720
# Isi 1 bila video ingin langsung diunduh saat analisis, bukan saat render
# ZOI_DOWNLOAD_AT_ANALYSIS=
